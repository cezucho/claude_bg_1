<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Browser client for the first playable. A local web server that holds one match and
    serves a broadcast-style page. Like the terminal client, it is presentation only
    (ADR-0001): it reads state, lists legal commands and applies them through Game.Apply,
    and holds no rules of its own. Uses the shared ASP.NET Core framework, so no NuGet
    packages are needed.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Augury.Web</RootNamespace>
    <AssemblyName>augury-web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Augury.Sim\Augury.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serve the page from the build output, so the server runs from any directory. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
